{
  "$schema": "https://schema.tauri.app/config/2.0",
  "productName": "QuietFlow",
  "version": "0.1.0",
  "identifier": "com.quietflow.app",
  "build": {
    "frontendDist": ".next",
    "devUrl": "http://localhost:3456"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "QuietFlow",
        "width": 1280,
        "height": 800,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 320,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}