# Keystore configuration — COPY TO keystore.properties AND FILL IN (DO NOT COMMIT)
# Generate keystore with:
# keytool -genkeypair -v -keystore quietflow-release.jks -alias quietflow -keyalg RSA -keysize 2048 -validity 10000

storeFile=../quietflow-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=quietflow
keyPassword=YOUR_KEY_PASSWORD